# ============================================================
# SALVATORÉ COMPETITION & PHOTOBOOTH CONFIGURATION
# ============================================================

# Salvatoré Spreadsheet URL or ID (REQUIRED for Salvatoré feature)
# SALVATORE_SPREADSHEET_URL=https://docs.google.com/spreadsheets/d/YOUR_SPREADSHEET_ID/edit

# Salvatoré Service Account Credentials
# SALVATORE_SHEETS_CREDENTIALS={"type":"service_account","project_id":"your-project-id",...}

# Ravenith Photobooth — Google Apps Script Web App URL
# RAVENITH_PHOTOBOOTH_GAS_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# ============================================================
# RECRUITMENT OSIS
# ============================================================
# RECRUITMENT_SPREADSHEET_ID=your_recruitment_spreadsheet_id_here

# ============================================================
# DUTA SISWA IGS 2026
# ============================================================
# Google Service Account Credentials specifically reserved for Duta Siswa IGS 2026

DUTA_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
DUTA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key_here\n-----END PRIVATE KEY-----"
DUTA_GOOGLE_SHEETS_ID=your_google_sheets_id_here
